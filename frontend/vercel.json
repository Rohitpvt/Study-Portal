{
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://intel-ai-backend-zk22.onrender.com/api/:match*"
    },
    {
      "source": "/api/:match*/",
      "destination": "https://intel-ai-backend-zk22.onrender.com/api/:match*"
